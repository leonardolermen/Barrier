            "body": {
              "mode": "raw",
              "raw": "{\n  \"documentType\": \"CPF\",\n  \"document\": \"111.444.777-35\",\n  \"name\": \"Fulano de Tal\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Depois deste, rode o **03.2** de novo: os `factors` agora trazem a contribuicao do historico."
          },
          "response": [],
