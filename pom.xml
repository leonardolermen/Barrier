<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.7</version>
        <relativePath/>
    </parent>

    <groupId>com.barrier</groupId>
    <artifactId>barrier-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Barrier</name>
    <description>Plataforma de KYC/PLD-FT — POM pai (Maven Reactor)</description>

    <modules>
        <module>commons</module>
        <module>services/risk-engine</module>
        <module>services/webhook-api</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- versões não gerenciadas pelo BOM do Spring Boot -->
        <mapstruct.version>1.6.3</mapstruct.version>
        <archunit.version>1.5.0</archunit.version>
        <spotless.version>2.44.0</spotless.version>
        <testcontainers.version>1.21.4</testcontainers.version>
        <!-- Fora do build padrão, pelo mesmo motivo: medem tempo/volume em vez de corretude, e
             falham por ruído de máquina num runner compartilhado — o que ensina o time a
             reexecutar o build em vez de ler o que ele diz.
               load      — teste de carga
               benchmark — medida de ordem de grandeza (o de screening sobe 100 mil entradas)
             Os testes de RECALL do screening, que impedem a otimização de perder cobertura, não
             têm tag e rodam sempre.
             Rodar sob demanda:  ./mvnw test -DexcludedGroups= -Dgroups=benchmark -->
        <excludedGroups>load,benchmark</excludedGroups>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct-processor</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- do JDK 23 em diante o javac não descobre processador pelo classpath
                         (-proc:none é o padrão); o caminho precisa ser declarado. Módulo que
                         sobrescreve annotationProcessorPaths tem de repetir o lombok. -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

        </plugins>

        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>${spotless.version}</version>
                    <configuration>
                        <java>
                            <googleJavaFormat/>
                            <removeUnusedImports/>
                        </java>
                    </configuration>
                    <executions>
                        <execution>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
